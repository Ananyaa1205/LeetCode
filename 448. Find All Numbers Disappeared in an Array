class Solution: ## BRUTE
    def findDisappearedNumbers(self, nums: list[int]) -> list[int]:
        n = len(nums)
        freq = {}
        ans = []
        for num in nums:
            if num in freq:
                freq[num] += 1
            else:
                freq[num] = 1
        for num in range(1,n+1):
            if num not in freq:
                ans.append(num)
        return ans

class Solution: ## OPTIMAL in place
    def findDisappearedNumbers(self, nums: list[int]) -> list[int]:
        n = len(nums)
        ans = []
        for num in nums:
            num = abs(num)
            index = num - 1
            if nums[index] > 0:
                nums[index] = -nums[index]
        for i in range(n):
            if nums[i] >= 0:
                ans.append(i+1)
        return ans

        
