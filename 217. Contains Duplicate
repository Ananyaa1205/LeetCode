class Solution: ## BRUTE FORCE
    def containsDuplicate(self, nums: list[int]) -> bool:
        freq = {}
        for x in nums:
            if x in freq:
                freq[x] += 1
            else:
                freq[x] = 1
        for x in freq:
            if freq[x] > 1:
                return(True)
            
        return(False)
        
class Solution: ## BETTER
    def containsDuplicate(self, nums: list[int]) -> bool:
        seen = set()
        for x in nums:
            if x in seen:
                return True
            seen.add(x)
        return False
class Solution: ## OPTIMAL
    def containsDuplicate(self, nums: list[int]) -> bool:
        return len(nums) != len(set(nums))
