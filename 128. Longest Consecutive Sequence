class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:
        if len(nums) ==0:
            return 0
        st = set(nums)
        longest = 1
        for it in st:
            if it-1 not in st:
                count = 1
                x = it
                while x+1 in st:
                   x = x+1
                   count+=1
                   longest = max(longest,count)
        return longest
