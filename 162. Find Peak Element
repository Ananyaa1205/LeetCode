class Solution:
    def findPeakElement(self, nums: List[int]) -> int:
        n = len(nums)
        low = 0
        high = n-1
        while low<high:
            mid = (low+high)//2
            if nums[mid]<nums[mid+1]: // left side is ignored
                low = mid+1
            elif nums[mid]>nums[mid+1]: // peak could be mid or on the left
                high = mid
        return low // when low,high become equal
        
