class Solution:
    def canConstruct(self, ransomNote: str, magazine: str) -> bool:
        freq = {}
        for char in magazine:
            if char in freq:
                freq[char] += 1
            else:
                freq[char] = 1
        for char in ransomNote:
            if char in freq and freq[char] > 0:
                freq[char] -= 1
            else:
                return False
        return True
        
class Solution:
    def canConstruct(self, ransomNote: str, magazine: str) -> bool:

        freq = [0] * 26
        for char in magazine:
            freq[ord(char) - ord('a')] += 1
        for char in ransomNote:
            index = ord(char) - ord('a')
            if freq[index] == 0:
                return False
            freq[index] -= 1
        return True
