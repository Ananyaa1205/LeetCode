class StockSpanner:  ## BRUTE FORCE WORST CASE O(n^2)

    def __init__(self):
        self.prices = []
        

    def next(self, price: int) -> int:
        self.prices.append(price)
        count = 1
        i = len(self.prices) - 2
        while i>=0 and self.prices[i]<=price:
            count+=1
            i-=1
        return count
        


