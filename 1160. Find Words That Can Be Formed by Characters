class Solution:
    def countCharacters(self, words: list[str], chars: str) -> int:
        freq = {}
        for char in chars:
            if char in freq:
                freq[char] += 1
            else:
                freq[char] = 1
        total = 0
        for word in words:
            valid = True
            dicti = freq.copy()
            for char in word:
                if char in dicti and dicti[char] > 0:
                    dicti[char] -=1
                else:
                    valid = False
                    break
            if valid:
                total += len(word)
        return total

        
