class Solution:
    def findKthPositive(self, arr: List[int], k: int) -> int:
        low = 1
        high = max(arr)+k
        ans=0
        
        while low<=high:
            mid= (low+high)//2
            missing = 0
            for i in range(1,mid+1):
                if i not in arr:
                    missing+=1
            if missing==k:
                ans=mid
                high = mid-1
            elif missing<k:
                low = mid+1
            elif missing>k:
                high = mid-1
        return ans
