class Solution: ## OPTIMAL
    def maxNumberOfBalloons(self, text: str) -> int:
        freq = {}
        maximun = 0
        for char in text:
            if char in freq:
                freq[char] += 1
            else:
                freq[char] = 1
        maximum = min(
            freq.get('b',0),
            freq.get('a',0),
            freq.get('l',0) // 2,
            freq.get('o',0) // 2,
            freq.get('n',0)
        )
        return maximum
