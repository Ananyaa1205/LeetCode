class Solution:
    def threeSum(self, nums: list[int]) -> list[list[int]]:
        n = len(nums)
        result = []
        seen = set()
        for i in range(n):
            for j in range(i+1,n):
                for k in range(j+1,n):
                    if nums[i] + nums[j] + nums[k] == 0:
                        triplet = [nums[i],nums[j],nums[k]]
                        triplet.sort()
                        key = tuple(triplet)
                        if key not in seen:
                            seen.add(key)
                            result.append(triplet)
        return result

        
