class Solution:
    def pivotIndex(self, nums: list[int]) -> int:
        prefix = [0] * (len(nums)+1)
        for i in range(len(nums)):
            prefix[i+1] = prefix[i] + nums[i]
        for i in range (len(nums)):
            left = prefix[i]
            right = prefix[-1] - left - nums[i]
            if left == right:
                return i
            
        return -1        

class Solution: ##OPTIMAL
    def pivotIndex(self, nums: list[int]) -> int:
        total = 0 
        left = 0
        for i in range(len(nums)):
            total += nums[i]
        for i in range(len(nums)):
            right = total - left - nums[i]
            if left == right:
                return i
            else:
                left += nums[i]
        return -1
